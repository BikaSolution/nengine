# The colonial rope drum: darker and longer than a snare, with a low body.
instrument field_drum
name "Field Drum"
family percussion
range C3 C6
wave noise
layer triangle 0.25 -24
envelope 0.001 0.24 0 0.05
vibrato 0 0 0
sweep 0 0
breath 0
tone 0.55
gain 0.85
color 190 170 140
end

instrument cymbal
