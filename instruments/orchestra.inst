# --- Chip: the three NES channels, straight ---

instrument pulse_lead
name "Pulse Lead"
family chip
range C2 C7
wave pulse 0.25
layer none
envelope 0.004 0.08 0.85 0.04
vibrato 6 0.08 0.15
sweep 0 0
breath 0
tone 1
gain 0.55
color 120 220 255
end

instrument square_lead
based_on pulse_lead
name "Square Lead"
wave pulse 0.5
color 150 255 180
end

instrument triangle_bass
name "Triangle Bass"
family chip
range A0 C5
wave nes_triangle
layer none
envelope 0.002 0.05 1 0.02
vibrato 0 0 0
sweep 0 0
breath 0
tone 1
gain 0.9
color 255 180 120
end

